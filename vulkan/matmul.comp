#version 450

// Each workgroup computes a 16x16 output tile using shared-memory input tiles.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer MatrixA { float a[]; };
layout(set = 0, binding = 1, std430) readonly buffer MatrixB { float b[]; };
layout(set = 0, binding = 2, std430) writeonly buffer MatrixC { float c[]; };
layout(push_constant) uniform Dimensions { uint m; uint k; uint n; } dims;

shared float tileA[16][16];
shared float tileB[16][16];

void main() {
    uint x = gl_LocalInvocationID.x;
    uint y = gl_LocalInvocationID.y;
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;
    float sum = 0.0;

    for (uint base = 0; base < dims.k; base += 16) {
        tileA[y][x] = (row < dims.m && base + x < dims.k)
            ? a[row * dims.k + base + x] : 0.0;
        tileB[y][x] = (base + y < dims.k && col < dims.n)
            ? b[(base + y) * dims.n + col] : 0.0;
        barrier();

        for (uint t = 0; t < 16; ++t)
            sum += tileA[y][t] * tileB[t][x];
        barrier(); // All threads finish reading before the next tile is loaded.
    }

    // Do not return early before the barriers: partial tiles still participate.
    if (row < dims.m && col < dims.n)
        c[row * dims.n + col] = sum;
}
